# 이 파일을 .env 로 **복사**한 뒤 값을 채우세요 (이동하지 말고 복사).
#   Windows: copy .env.example .env
# 값은 https://discord.com/developers/applications 에서 발급합니다.

# Bot 탭 > Reset Token 으로 발급한 토큰
DISCORD_TOKEN=

# General Information 탭의 Application ID
DISCORD_CLIENT_ID=

# 개발용 테스트 서버 ID (서버 이름 우클릭 > ID 복사).
# 값이 있으면 그 서버에만 커맨드를 등록해 반영이 즉시 됩니다.
# 비워 두면 글로벌 등록(모든 서버, 반영까지 최대 1시간)이 됩니다.
DISCORD_GUILD_ID=

# debug | info | warn | error
LOG_LEVEL=info
